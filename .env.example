GOOGLE_MAPS_API_KEY=your_google_maps_static_api_key
# Optional: URL signing secret for Google Maps Static API.
# GOOGLE_MAPS_SIGNATURE_SECRET=

# Environment: keep as local during development only.
APP_ENV=local

# Any deployment reachable by other people must set APP_ENV=production and both
# reCAPTCHA v3 keys below. Startup fails in production when they are missing.
# RECAPTCHA_SITE_KEY=
# RECAPTCHA_SECRET_KEY=

# Maximum GPX upload size in bytes. Default: 5242880 (5 MiB).
# MAX_UPLOAD_BYTES=5242880

# Maximum track points accepted per GPX upload. Default: 50000.
# MAX_ROUTE_POINTS=50000

# Maximum concurrent renders and queued render jobs. Defaults: 1 and 2.
# MAX_ACTIVE_RENDERS=1
# MAX_QUEUED_RENDERS=2

# Job artifact retention. Defaults: 24 hours, 100 jobs, 2 GiB.
# JOB_RETENTION_HOURS=24
# MAX_RETAINED_JOBS=100
# MAX_JOB_STORAGE_BYTES=2147483648

# Per-process, per-connecting-peer request limits. Window: 60 seconds.
# Behind a reverse proxy this is one shared proxy quota; configure client-aware
# limits at the proxy because the app does not trust forwarded headers.
# PREVIEW_REQUESTS_PER_MINUTE=30
# RENDER_REQUESTS_PER_MINUTE=6

# Maximum preview renders running at once. Excess previews receive HTTP 429.
# MAX_ACTIVE_PREVIEWS=2

# Unsafe override: disabling this requirement lets production start without
# reCAPTCHA protection, so any caller can start renders. Enable it only for a
# trusted single-operator host, never for a public deployment.
# ALLOW_UNPROTECTED_RENDERING=false
