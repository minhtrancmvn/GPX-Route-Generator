GOOGLE_MAPS_API_KEY=your_google_maps_static_api_key
# Optional: URL signing secret for Google Maps Static API.
# GOOGLE_MAPS_SIGNATURE_SECRET=

# Environment: keep as local during development, set to production on your server.
APP_ENV=local

# Optional production-only reCAPTCHA v3 keys for protecting the Render MP4 action.
# RECAPTCHA_SITE_KEY=
# RECAPTCHA_SECRET_KEY=
