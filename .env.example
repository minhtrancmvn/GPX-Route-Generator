GOOGLE_MAPS_API_KEY=your_google_maps_static_api_key
# Optional: URL signing secret for Google Maps Static API.
# GOOGLE_MAPS_SIGNATURE_SECRET=

# Environment: keep as local during development, set to production on your server.
APP_ENV=local

# Optional production-only reCAPTCHA v3 keys for protecting the Render MP4 action.
# RECAPTCHA_SITE_KEY=
# RECAPTCHA_SECRET_KEY=

# Maximum GPX upload size in bytes. Default: 5242880 (5 MiB).
# MAX_UPLOAD_BYTES=5242880

# Maximum track points accepted per GPX upload. Default: 50000.
# MAX_ROUTE_POINTS=50000

# Production must have reCAPTCHA keys unless this explicit override is enabled.
# Keep false for public deployments.
# ALLOW_UNPROTECTED_RENDERING=false
